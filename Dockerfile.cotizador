FROM nginx:alpine

# Copiar el archivo HTML principal
COPY cotizador-cliente.html /usr/share/nginx/html/index.html

# Copiar archivos de Supabase necesarios
COPY supabase-config.js /usr/share/nginx/html/
COPY supabase-client.js /usr/share/nginx/html/

# Configuración de Nginx: anti-caché para cotizador (evitar lista de hoteles vieja en móviles/otros dispositivos)
RUN echo 'server { \
    listen 80; \
    server_name _; \
    root /usr/share/nginx/html; \
    index index.html; \
    \
    # Anti-caché para HTML y JS del cotizador (lista de hoteles y lógica se actualizan por deploy) \
    location /index.html { \
        add_header Cache-Control "no-cache, no-store, must-revalidate"; \
        add_header Pragma "no-cache"; \
        add_header Expires "0"; \
    } \
    location ~* ^/(supabase-client|supabase-config)\\.js { \
        add_header Cache-Control "no-cache, no-store, must-revalidate"; \
        add_header Pragma "no-cache"; \
        add_header Expires "0"; \
    } \
    \
    # Cache solo para fuentes e imágenes externas si las hubiera \
    location ~* \\.(png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ { \
        add_header Cache-Control "public, max-age=3600"; \
    } \
    \
    # Raíz: no cachear, servir index.html para SPA \
    location / { \
        add_header Cache-Control "no-cache, no-store, must-revalidate"; \
        add_header Pragma "no-cache"; \
        add_header Expires "0"; \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

# Exponer puerto 80
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
