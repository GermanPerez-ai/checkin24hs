# Dockerfile para WhatsApp Server - Checkin24hs (Flor IA + Baileys)
# Para usar con BUILD CONTEXT = raíz del repo (EasyPanel: context ".", dockerfile "Dockerfile.whatsapp")

FROM node:20-slim

RUN apt-get update && apt-get install -y \
    python3 make g++ ca-certificates git ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR /app
COPY whatsapp-server/package*.json ./
# Instalar todas las deps explícitamente (el package.json del servidor puede estar incompleto)
RUN npm install --production && \
    npm install @whiskeysockets/baileys@^6.7.4 qrcode express cors socket.io @supabase/supabase-js axios link-preview-js @hapi/boom --save --no-package-lock && \
    node -e "require('@whiskeysockets/baileys'); require('qrcode'); console.log('Deps OK');" || (echo "FATAL: faltan módulos" && exit 1)
COPY whatsapp-server/whatsapp-server-baileys.js ./
COPY whatsapp-server/whatsapp-server.js ./

RUN mkdir -p logs auth_info_baileys_1 auth_info_baileys_2 auth_info_baileys_3 auth_info_baileys_4

EXPOSE 3001
ENV PORT=3001
CMD ["node", "whatsapp-server-baileys.js"]
