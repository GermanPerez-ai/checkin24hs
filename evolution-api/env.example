# Evolution API - Configuración
# Copia este archivo a .env y ajusta los valores

# API Key para autenticación (cambia esto por una clave segura)
AUTHENTICATION_API_KEY=checkin24hs-secret-key-2024-cambiar-en-produccion

# URL del servidor (cambia por tu dominio o IP)
SERVER_URL=http://localhost:8080

# URL del webhook para recibir mensajes (cambia por tu servidor)
WEBHOOK_GLOBAL_URL=http://localhost:3000/webhook/evolution

# Configuración de base de datos (opcional, usa SQLite por defecto)
# DATABASE_PROVIDER=postgresql
# DATABASE_CONNECTION_URI=postgresql://user:password@postgres:5432/evolution

# Configuración de Redis (ya está configurado en docker-compose)
REDIS_ENABLED=true
REDIS_URI=redis://redis:6379


