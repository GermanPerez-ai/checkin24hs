IMAP_HOST=127.0.0.1
IMAP_PORT=143
IMAP_USER=reservas
IMAP_PASS=
# Si el certificado del mail es autofirmado, dejá en 0:
IMAP_TLS_REJECT_UNAUTHORIZED=0
# LOGIN (no AUTH PLAIN): Dovecot+PAM rechaza AUTHENTICATE PLAIN de ImapFlow
IMAP_LOGIN_METHOD=LOGIN
IMAP_SECURE=0

SUPABASE_URL=https://lmoeuyasuvoqhtvhkyia.supabase.co
# Preferí service_role (Settings → API). No lo subas a git.
SUPABASE_SERVICE_ROLE_KEY=

