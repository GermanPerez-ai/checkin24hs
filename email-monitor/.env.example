# ===== CONFIGURACIÓN IMAP =====
# El correo reservas@checkin24hs.com está alojado en Hostinger
# Configuración IMAP de Hostinger (SSL)
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=reservas@checkin24hs.com
IMAP_PASS=
# 1 para TLS/SSL, 0 para conexión sin cifrar (no recomendado)
IMAP_SECURE=1
IMAP_TLS_REJECT_UNAUTHORIZED=1

# Buzón a monitorear (INBOX por defecto)
IMAP_MAILBOX=INBOX

# Cuántos días hacia atrás revisar en cada ejecución (default: 7)
IMAP_SINCE_DAYS=7

# ===== SUPABASE =====
SUPABASE_URL=https://lmoeuyasuvoqhtvhkyia.supabase.co
# Usar service_role key desde Settings → API
# ⚠️ NO subir esta key a git ni compartirla públicamente
SUPABASE_SERVICE_ROLE_KEY=

# ===== WHATSAPP =====
# URL del servidor de WhatsApp con Baileys (instancia 1 por defecto)
# En producción (Docker Swarm): https://whatsapp.checkin24hs.com
# En desarrollo local: http://localhost:3001
# Si usas otra instancia, cambia el puerto (3002, 3003, 3004)
WHATSAPP_API_URL=https://whatsapp.checkin24hs.com

# API Key para autenticación con el servidor de WhatsApp
# Debe ser la misma que WHATSAPP_API_KEY del servidor
# (Ver PR #2: https://github.com/GermanPerez-ai/checkin24hs/pull/2)
WHATSAPP_API_KEY=

# ID del grupo de WhatsApp donde notificar correos de HOTELES
# Formato: 120363123456789012@g.us
# Ver documentación para obtener este ID
WHATSAPP_GROUP_ID=

# Números WhatsApp para notificar correos de PROVEEDORES/AGENCIAS/WHOLESALERS
# Formato: números separados por comas, solo dígitos (se envían a <numero>@s.whatsapp.net)
# Ejemplo: 5492944210725,5492944579759
WHATSAPP_PROVIDER_NUMBERS=5492944210725,5492944579759

# ===== CLASIFICACIÓN DE REMITENTES =====
# Dominios de proveedores/agencias/wholesalers (envían a números individuales)
# Todo lo que NO matchee con estos dominios se considera HOTEL y va al grupo
PROVIDER_DOMAINS=tanica.com,ratehawk.com,emergingtravel.com

# Dominios de hoteles (opcional - para forzar clasificación explícita)
# Si está vacío, cualquier email que no sea proveedor se considera hotel
HOTEL_DOMAINS=

# Remitentes internos a EXCLUIR (no se notifican)
# Formato: dominios completos o emails específicos separados por comas
INTERNAL_SENDERS=checkin24hs.com,checkin24hs@gmail.com,axelbisio@hotmail.com

# ===== IA (OPCIONAL) =====
# API Key de Gemini para generar resúmenes ejecutivos
# Si no se configura, usa resumen simple sin IA
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Modelo de Gemini (default: gemini-2.0-flash-lite)
GEMINI_MODEL=gemini-2.0-flash-lite

# ===== PALABRAS CLAVE PARA FILTRADO =====
# Lista separada por comas de palabras clave que identifican correos de reservas
# El filtro busca estas palabras en el asunto y cuerpo del correo
FILTER_KEYWORDS=reserva,modificación,modificacion,anulación,anulacion,cancelación,cancelacion,voucher,cupo,confirmación,confirmacion

# ===== MODO DE PRUEBA =====
# 1 para modo dry-run (no envía a WhatsApp ni marca como procesado)
DRY_RUN=0
